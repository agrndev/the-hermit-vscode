{
  "name": "The Hermit",
  "colors": {
    "editor.background": "#121110",
    "editor.foreground": "#acaeb0",
    "activityBar.background": "#121110",
    "titleBar.activeBackground": "#313131",

    "editor.lineHighlightBackground": "#1a1918",
    "editor.selectionBackground": "#363636",

    "editorLineNumber.foreground": "#59514c",
    "editorLineNumber.activeForeground": "#d97a36",

    "breadcrumb.activeSelectionForeground": "#d8d2c4",
    "breadcrumb.background": "#1a1918",
    "breadcrumb.foreground": "#acaeb0",

    "notificationToast.border": "#404040",
    "notifications.border": "#404040",

    "sideBar.background": "#121110",
    "sideBarSectionHeader.border": "#333333",

    "terminal.background": "#121110",
    "terminal.border": "#333333",

    "editorCursor.foreground": "#acaeb0",
    "editorCursor.background": "#333333",

    "input.background": "#222222",

    "editorBracketHighlight.foreground1": "#b75433",
    "editorBracketHighlight.foreground2": "#b75433",
    "editorBracketHighlight.foreground3": "#a8522d",
    "editorBracketHighlight.foreground4": "#d97a36",
    "editorBracketHighlight.foreground5": "#7a7468",
    "editorBracketHighlight.foreground6": "#d8d2c4"
  },
  "semanticTokenColors": {
    "method.declaration": {
      "foreground": "#b75433"
    },
    "function.declaration": {
      "foreground": "#b75433"
    },
    "function.declaration.async": {
      "foreground": "#b75433"
    },
    "method": {
      "foreground": "#b75433",
      "fontStyle": ""
    },
    "function": {
      "foreground": "#b75433",
      "fontStyle": ""
    },
    "variable.defaultLibrary": {
      "foreground": "#b75433",
      "fontStyle": "bold"
    },
    "namespace": {
      "foreground": "#b75433",
      "fontStyle": ""
    },
    "class": {
      "foreground": "#b75433",
      "fontStyle": ""
    },
    "interface": {
      "foreground": "#b75433"
    },
    "variable": {
      "foreground": "#d8d2c4",
      "fontStyle": ""
    },
    "type": {
      "foreground": "#b75433",
      "fontStyle": "bold"
    },
    "property": {
      "foreground": "#b75433",
      "fontStyle": ""
    },
    "property.declaration": {
      "foreground": "#b75433",
      "fontStyle": ""
    },
    "enumMember": {
      "foreground": "#a8522d",
      "fontStyle": ""
    },
    "enum": {
      "foreground": "#b75433",
      "fontStyle": ""
    },
    "struct": {
      "foreground": "#b75433"
    },
    "selfTypeKeyword": {
      "foreground": "#a8522d",
      "fontStyle": "bold"
    },
    "selfKeyword": {
      "foreground": "#a8522d",
      "fontStyle": "bold"
    }
  },
  "tokenColors": [
    {
      "name": "Punctuation, function and method calls",
      "scope": [
        "punctuation",
        "punctuation.section.embedded",
        "meta.function-call",
        "punctuation.definition.constant.hashkey",
        "entity.name.function.call.cpp",
        "entity.name.function.member.cpp",
        "variable.other.object.property",
        "variable.other.property",
        "meta.brace.round.ts",
        "meta.brace.square.ts",
        "keyword.operator.type.ts",
        "keyword.operator.type.annotation.ts",
        "meta.function-call.ts",
        "keyword.operator.assignment.ts",
        "keyword.operator.relational.ts",
        "keyword.operator.increment.ts",
        "keyword.operator.bitwise.shift.ts",
        "keyword.operator.bitwise.ts",
        "punctuation.separator.key-value.ts",
        "keyword.operator.assignment.js",
        "keyword.operator.relational.js",
        "keyword.operator.increment.js",
        "keyword.operator.bitwise.shift.js",
        "keyword.operator.bitwise.js",
        "variable.other.object.property.js",
        "support.variable.property.js",
        "meta.brace.round.js",
        "meta.brace.square.js",
        "keyword.generator.asterisk.js",
        "keyword.operator.combinator.css",
        "meta.property-name.css",
        "punctuation.definition.constant.css",
        "punctuation.separator.key-value.mapping.yaml",
        "string.unquoted.plain.out.yaml",
        "source.sql",
        "constant.other.table-name.sql",
        "meta.function.call.rust",
        "keyword.operator.key-value.rust",
        "keyword.operator.assignment.c",
        "keyword.operator.comparison.c",
        "keyword.operator.increment.c"
      ],
      "settings": {
        "foreground": "#b75433"
      }
    },
    {
      "name": "Comments",
      "scope": ["punctuation.definition.comment", "comment"],
      "settings": {
        "foreground": "#7a7468",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword.other",
        "keyword.operator",
        "keyword.control",
        "keyword.other.special-method",
        "punctuation.separator.key-value",
        "variable.language",
        "storage.type.variable",
        "storage.modifier",
        "storage.type.built-in.primitive.c",
        "storage.type.built-in.primitive.cpp",
        "storage.type.primitive.cpp",
        "punctuation.separator.pointer-access.cpp",
        "punctuation.definition.heading.markdown",
        "punctuation.definition.constant.markdown",
        "punctuation.definition.string.begin.markdown",
        "punctuation.definition.string.end.markdown",
        "punctuation.definition.list.begin.markdown",
        "storage.type.function.arrow.ts",
        "storage.type.function.ts",
        "storage.type.interface.ts",
        "storage.type.enum.ts",
        "support.constant.media.css",
        "support.constant.property-value.css",
        "support.constant.font-name.css",
        "entity.name.type.primitive.rust",
        "entity.name.type.numeric.rust"
      ],
      "settings": {
        "foreground": "#c47433"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "constant.other.symbol.hashkey.parameter.function",
        "variable.other",
        "markup.inline.raw.string.markdown",
        "markup.fenced_code.block.markdown",
        "entity.other.attribute-name.html",
        "constant.other.color.rgb-value.hex.css",
        "support.constant.color.w3c-standard-color-name.css",
        "constant.other.database-name.sql"
      ],
      "settings": {
        "foreground": "#d8d2c4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end",
        "string"
      ],
      "settings": {
        "foreground": "#b75433"
      }
    },
    {
      "scope": "meta.embedded.line",
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Regexp",
      "scope": ["string.regexp", "punctuation.section.regexp"],
      "settings": {
        "foreground": "#a8522d",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "keyword.other.unit.em.css",
        "keyword.other.unit.percentage.css",
        "keyword.other.unit.rem.css",
        "keyword.other.unit.px.css"
      ],
      "settings": {
        "foreground": "#a8522d"
      }
    },
    {
      "name": "Classes, modules and namespaces",
      "scope": [
        "support.class",
        "meta.class",
        "entity.name.type.module",
        "variable.other.constant",
        "entity.name.scope-resolution.cpp",
        "entity.name.scope-resolution.template.call.cpp",
        "entity.name.scope-resolution.parameter.cpp",
        "entity.name.scope-resolution.function.call.cpp",
        "markup.heading",
        "constant.other.reference.link.markdown",
        "string.other.link.title.markdown",
        "meta.selector.css",
        "entity.name.namespace.rust",
        "entity.name.type.enum.ts",
        "variable.other.readwrite.alias.ts"
      ],
      "settings": {
        "foreground": "#b75433",
        "fontStyle": ""
      }
    },
    {
      "name": "Symbols",
      "scope": [
        "constant.language.symbol",
        "markup.underline.link.markdown",
        "meta.link.inline.markdown",
        "support.type.property-name.json",
        "meta.object-literal.key.ts",
        "meta.object-literal.key.js",
        "entity.name.tag.html",
        "punctuation.separator.key-value.css",
        "punctuation.terminator.rule.css",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#a8522d",
        "fontStyle": ""
      }
    },
    {
      "name": "Language constants and special variables",
      "scope": ["constant.language", "variable.language.this"],
      "settings": {
        "foreground": "#a8522d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Local variables",
      "scope": [
        "variable",
        "markup.bold",
        "punctuation.definition.bold.markdown",
        "variable.object.property.ts",
        "variable.other.constant.object.ts",
        "variable.other.constant.js",
        "variable.other.constant.object.js"
      ],
      "settings": {
        "foreground": "#d8d2c4",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "storage.type.ts",
        "support.type.primitive.ts",
        "storage.type.class.ts",
        "storage.type.class.js",
        "storage.type.function.js",
        "storage.type.js",
        "storage.type.function.arrow.js",
        "constant.language.null.js"
      ],
      "settings": {
        "foreground": "#b75433",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Method and function definitions",
      "scope": [
        "meta.definition.method"
      ],
      "settings": {
        "foreground": "#b75433"
      }
    },
    {
      "name": "Method and function calls",
      "scope": ["meta.function-call"],
      "settings": {
        "foreground": "#acaeb0"
      }
    },
    {
      "name": "diff: header",
      "scope": [
        "meta.diff",
        "meta.diff.header",
        "punctuation.definition.to-file.diff",
        "punctuation.definition.from-file.diff",
        "punctuation.definition.range.diff"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c47433"
      }
    },
    {
      "name": "diff: deleted",
      "scope": ["markup.deleted", "punctuation.definition.deleted.diff"],
      "settings": {
        "fontStyle": "",
        "foreground": "#7A3A3A"
      }
    },
    {
      "name": "diff: changed",
      "scope": "markup.changed",
      "settings": {
        "fontStyle": "",
        "foreground": "#7A6030"
      }
    },
    {
      "name": "diff: inserted",
      "scope": ["markup.inserted", "punctuation.definition.inserted.diff"],
      "settings": {
        "foreground": "#4A7A4A"
      }
    }
  ]
}
